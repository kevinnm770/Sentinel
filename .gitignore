data/*.db
data/*.sqlite3
logs/*.log

# Entorno virtual de Python
.venv/
venv/

# Cache y artefactos de Python
__pycache__/
*.pyc

# Cache de pytest
.pytest_cache/

# Archivos de IDE
.vscode/
.idea/
