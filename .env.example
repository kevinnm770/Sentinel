# Token del bot, obtenido en discord.com/developers/applications > tu app > Bot > Reset Token
# NUNCA compartas este valor ni lo subas a git.
DISCORD_TOKEN=

# ID del servidor (guild) de Discord donde estás probando el bot.
# Se usa para sincronizar los slash commands solo ahí durante desarrollo
# (sincronización instantánea) en vez de globalmente (tarda hasta 1 hora
# en aparecer en todos los servidores). Click derecho al servidor en
# Discord con el modo desarrollador activado > "Copiar ID de servidor".
DEV_GUILD_ID=

# Zona horaria única usada para interpretar y mostrar todos los horarios
# de coaching (ver lista en https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=America/Bogota

# Ruta al archivo de base de datos SQLite
DATABASE_URL=sqlite+aiosqlite:///data/sentinel.db

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Minutos de anticipación con que se avisa en el canal que una sesión está
# por empezar (y se abre el acceso al canal de voz asignado)
ANNOUNCE_MINUTES_BEFORE=10
